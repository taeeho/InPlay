# =============================================================
# inplay — environment variables example
# Copy this to .env and fill in real values. NEVER commit .env.
# =============================================================

# === MongoDB ===
MONGO_URI=mongodb://localhost:27017/inplay

# === Discord webhook (default user) ===
# Get yours from: Server settings → Integrations → Webhooks → New Webhook
INPLAY_DEFAULT_DISCORD_WEBHOOK=https://discord.com/api/webhooks/YOUR_ID/YOUR_TOKEN

# === Default user (W6에서 시드되는 본인 계정) ===
INPLAY_DEFAULT_USER_NAME=taeeho
INPLAY_DEFAULT_USER_TEAM=HH
INPLAY_DEFAULT_USER_TIMEZONE=Asia/Seoul
INPLAY_DEFAULT_USER_MUTE_START=08:00
INPLAY_DEFAULT_USER_MUTE_END=10:00

# === Optional: cloud deploy (없으면 로컬 fallback) ===
SUPABASE_URL=
SUPABASE_KEY=
VERCEL_TOKEN=
VERCEL_PROJECT_ID=

# === Optional: Notion API (W6 자동 일지) ===
NOTION_API_KEY=
NOTION_INPLAY_PAGE_ID=35dbc507-d1ef-80ab-ac81-cb5318e96c78

# === Optional: LLM (W6 비시즌 뉴스 요약) ===
OLLAMA_HOST=http://localhost:11434
ANTHROPIC_API_KEY=

# === ML serving ===
INPLAY_MODEL_DIR=modules/ml-inference/src/main/resources/models
